    "levelIntro.addition.intro": {
      "comment": "First line of the level intro card for Addition, saying what the sums do. Emphasise the operation with Markdown **bold**, wherever it falls in your sentence.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Somme waar jy 'n getal \\*\\*optel\\*\\*."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ቁጥርን **የምትደምርባቸው** ስሌቶች።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسائل **تضيف** فيها عددًا."
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "য’ত তুমি এটা সংখ্যা **যোগ** কৰা অংক।"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ədədi **topladığın** misallar."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Прыклады, дзе трэба **дадаць** лік."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Задачи, в които **събираш** число."
          }
        },
        "bn": {
          "stringUnit": {
