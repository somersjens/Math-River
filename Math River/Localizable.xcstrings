        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक केकड़ा सही जवाब लेकर आ रहा है। गलत वाले को मारो और सही वाले को तुम्हारे राजा तक पहुँचने दो!"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedan rak nosi točan odgovor. Pogodi pogrešnog i pusti točnog da stigne do tvog Kralja!"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egyik rák a helyes választ hozza. Találd el a rosszat, és engedd, hogy a helyes eljusson a Királyodhoz!"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մի խեցգետին տանում է ճիշտ պատասխանը։ Խփիր սխալ պատասխանով խեցգետնին և թող ճիշտը հասնի քո Թագավորին։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu kepiting membawa jawaban yang benar. Hantam yang salah dan biarkan yang benar sampai ke Rajamu!"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Einn krabbi ber rétta svarið. Hittu þann ranga og leyfðu þeim rétta að komast til Konungsins þíns!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un granchio porta la risposta giusta. Colpisci quello sbagliato e lascia che quello giusto raggiunga il tuo Re!"
