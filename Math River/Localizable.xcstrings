        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empecemos. ¿Cómo te llamas?"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakkame pihta. Mis su nimi on?"
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Has gaitezen. Nola duzu izena?"
