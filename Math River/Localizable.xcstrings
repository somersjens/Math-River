          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Избери дневна или седмична цел"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দৈনিক বা সাপ্তাহিক লক্ষ্য বেছে নাও"
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "ཉིན་རེའམ་བདུན་རེའི་དམིགས་ཡུལ་འདེམས།"
