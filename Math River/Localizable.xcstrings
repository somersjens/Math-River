        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бір шаян дұрыс жауапты алып келеді. Қате жауапты ұр да, дұрысының Патшаңа жетуіне жол бер!"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ក្តាមមួយកំពុងនាំចម្លើយត្រឹមត្រូវ។ វាយក្តាមដែលមានចម្លើយខុស ហើយទុកក្តាមដែលមានចម្លើយត្រឹមត្រូវឲ្យទៅដល់ស្តេច!"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಒಂದು ಏಡಿ ಸರಿಯಾದ ಉತ್ತರವನ್ನು ಹೊತ್ತು ಬರುತ್ತಿದೆ. ತಪ್ಪಾದದ್ದನ್ನು ಹೊಡೆದು, ಸರಿಯಾದದ್ದು ನಿನ್ನ ರಾಜನ ಬಳಿಗೆ ತಲುಪಲು ಬಿಡು!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게 한 마리가 정답을 들고 있어요. 오답을 든 게는 맞히고, 정답을 든 게는 왕에게 가도록 보내 주세요!"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ປູໂຕໜຶ່ງຖືຄຳຕອບທີ່ຖືກ. ຈັດການໂຕທີ່ຜິດ ແລະປ່ອຍໂຕທີ່ຖືກໃຫ້ໄປເຖິງກະສັດ!"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vienas krabas neša teisingą atsakymą. Pataikyk į neteisingą ir leisk teisingam pasiekti tavo Karalių!"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Viens krabis nes pareizo atbildi. Trāpi nepareizajam un ļauj pareizajam sasniegt tavu Karali!"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Еден рак го носи точниот одговор. Погоди го погрешниот и пушти го точниот да стигне до твојот Крал!"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു ഞണ്ട് ശരിയായ ഉത്തരം കൊണ്ടുവരുന്നു. തെറ്റായതിനെ അടിക്കൂ, ശരിയായത് നിന്റെ രാജാവിന്റെ അടുത്തെത്താൻ അനുവദിക്കൂ!"
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нэг хавч зөв хариуг авч явна. Бурууг нь оноод, зөвийг нь Хаанд чинь хүргэ!"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एक खेकडा बरोबर उत्तर घेऊन येतोय. चुकीच्याला मार आणि बरोबर उत्तराला तुझ्या राजापर्यंत पोहोचू दे!"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seekor ketam membawa jawapan yang betul. Kena yang salah dan biarkan yang betul sampai kepada Raja kamu!"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ကဏန်းတစ်ကောင်က အဖြေမှန်ကို ယူလာတယ်။ အဖြေမှားတဲ့ကောင်ကို ထိပြီး အဖြေမှန်တဲ့ကောင်ကို မင်းကြီးဆီ ရောက်အောင် လွှတ်ပေးလိုက်!"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Én krabbe har det riktige svaret. Treff den gale og la den riktige nå Kongen din!"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "एउटा गँगटोले सही उत्तर बोकेको छ। गलतलाई हान र सहीलाई तिम्रो राजासम्म पुग्न देऊ!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén krab draagt het juiste antwoord. Sla de foute weg en laat de goede bij je King komen!"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଗୋଟିଏ କଙ୍କଡ଼ା ସଠିକ୍ ଉତ୍ତର ନେଇ ଆସୁଛି। ଭୁଲଟିକୁ ମାର ଏବଂ ସଠିକ୍ଟିକୁ ତୁମ ରାଜାଙ୍କ ପାଖକୁ ଯିବାକୁ ଦିଅ!"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇੱਕ ਕੇਕੜਾ ਸਹੀ ਜਵਾਬ ਲੈ ਕੇ ਆ ਰਿਹਾ ਹੈ। ਗਲਤ ਵਾਲੇ ਨੂੰ ਮਾਰ ਅਤੇ ਸਹੀ ਵਾਲੇ ਨੂੰ ਆਪਣੇ ਰਾਜੇ ਤੱਕ ਪਹੁੰਚਣ ਦੇ!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden krab niesie poprawną odpowiedź. Traf błędnego i pozwól poprawnemu dotrzeć do twojego Króla!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um caranguejo leva a resposta certa. Acerta no errado e deixa o certo chegar ao teu Rei!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un crab poartă răspunsul corect. Lovește-l pe cel greșit și lasă-l pe cel corect să ajungă la Regele tău!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один краб несёт правильный ответ. Сбей неправильного и пропусти правильного к своему Королю!"
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "එක කකුළුවෙක් හරි උත්තරය අරගෙන එනවා. වැරදි එකට ගහලා හරි එකට ඔයාගේ රජු ළඟට යන්න දෙන්න!"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden krab nesie správnu odpoveď. Traf nesprávneho a nechaj správneho dôjsť ku Kráľovi!"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "En rak nosi pravilen odgovor. Zadeni napačnega in pusti pravilnemu, da pride do tvojega Kralja!"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Një gaforre mban përgjigjen e saktë. Godit të gabuarën dhe lëre të saktën të arrijë te Mbreti yt!"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Један рак носи тачан одговор. Погоди погрешног и пусти тачног да стигне до твог Краља!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En krabba har rätt svar. Träffa den felaktiga och låt den rätta nå din Kung!"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaa mmoja amebeba jibu sahihi. Mpige aliye na jibu lisilo sahihi na umruhusu mwenye jibu sahihi afike kwa Mfalme wako!"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு நண்டு சரியான பதிலை எடுத்துக்கொண்டு வருகிறது. தவறானதை அடித்து, சரியானது உன் ராஜாவிடம் செல்ல விடு!"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక పీత సరైన సమాధానాన్ని తీసుకొస్తోంది. తప్పుదాన్ని కొట్టు, సరైనదాన్ని నీ రాజు దగ్గరకు వెళ్లనివ్వు!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีปูหนึ่งตัวถือคำตอบที่ถูกต้องอยู่ จัดการตัวที่ถือคำตอบผิด แล้วปล่อยตัวที่ถูกต้องให้ไปถึงพระราชา!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir yengeç doğru cevabı taşıyor. Yanlış olanı vur ve doğru olanın Kralına ulaşmasına izin ver!"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "بىر قىسقۇچپاقا توغرا جاۋابنى ئېلىپ كېلىۋاتىدۇ. خاتا جاۋابلىقنى ئۇرۇپ، توغرا جاۋابلىقنى پادىشاھىڭىزغا يەتكۈزۈڭ!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один краб несе правильну відповідь. Влуч у неправильного й пропусти правильного до свого Короля!"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک کیکڑا صحیح جواب لے کر آ رہا ہے۔ غلط والے کو مارو اور صحیح والے کو بادشاہ تک پہنچنے دو!"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitta qisqichbaqa to‘g‘ri javobni olib kelmoqda. Noto‘g‘risini ur va to‘g‘risining Qirolingga yetib borishiga yo‘l ber!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một con cua mang đáp án đúng. Đánh con mang đáp án sai và để con mang đáp án đúng đến được với Đức Vua!"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "有一只螃蟹带着正确答案。打掉错误的，让正确的走到国王身边！"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Enye inkalankala iphethe impendulo elungile. Shaya ephethe engalungile, uvumele ephethe elungile ifike eNkosini yakho!"
          }
        }
      }
    },
    "tutorial.step.3": {
      "comment": "Walkthrough step 3 of 10: what a mistake costs — crabs that get through cost half a life, smashing the right answer costs a whole one. Spoken to a young child, one or two short sentences.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Krappe wat jou Koning bereik, kos ’n halwe lewe, maak nie saak hoeveel deurkom nie. Gooi jy sand na die regte antwoord, kos dit ’n hele lewe!"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ወደ ንጉሥህ የሚደርሱ ሸርጣኖች ስንትም ቢሆኑ ግማሽ ሕይወት ያስከፍላሉ። ትክክለኛው መልስ ላይ አሸዋ ከወረወርክ ሙሉ አንድ ሕይወት ታጣለህ!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السرطانات التي تصل إلى ملكك تكلّفك نصف حياة، مهما كان عددها. إذا رميت الرمل على الإجابة الصحيحة فستخسر حياة كاملة!"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমাৰ ৰজাৰ ওচৰ পোৱা কেঁকোৰাবোৰে আধা জীৱন কমায়, কিমান পাৰ হৈ যায় সেয়া কথা নহয়। শুদ্ধ উত্তৰটোৰ ওপৰত বালি ছটিয়ালে এটা সম্পূৰ্ণ জীৱন হেৰাবা!"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kralına çatan xərçənglər, neçə dənə keçməsindən asılı olmayaraq, yarım can aparır. Düzgün cavaba qum atsan, bir tam can itirəcəksən!"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Крабы, якія дойдуць да Караля, каштуюць палову жыцця, колькі б іх ні прайшло. Калі кінеш пяском у правільны адказ, страціш цэлае жыццё!"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Раците, които стигнат до твоя Крал, струват половин живот, независимо колко са. Ако хвърлиш пясък по верния отговор, губиш цял живот!"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যে কাঁকড়াগুলো তোমার রাজার কাছে পৌঁছায়, তারা অর্ধেক জীবন কমিয়ে দেয়—কতগুলো পেরোয় তা গুরুত্বপূর্ণ নয়। সঠিক উত্তরে বালি ছুড়লে পুরো একটি জীবন হারাবে!"
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "སྡིག་སྲིན་རྒྱལ་པོའི་རྩར་སླེབས་ན། ག་ཚོད་སོང་ཡང་སྲོག་ཕྱེད་ཀ་ཉུང་དུ་འགྲོ། ལན་འགྲིག་པའི་སྟེང་བྱེ་མ་གཏོར་ན་སྲོག་གཅིག་ཆ་ཚང་ཤོར་གྱི་རེད།"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakovi koji stignu do tvog Kralja koštaju pola života, bez obzira koliko ih prođe. Ako baciš pijesak na tačan odgovor, gubiš cijeli život!"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els crancs que arriben al teu Rei costen mitja vida, tant se val quants en passin. Si llances sorra a la resposta correcta, perds una vida sencera!"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Krabi, kteří dojdou ke Králi, stojí půl života, ať jich projde kolik chce. Když hodíš písek na správnou odpověď, přijdeš o celý život!"
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae crancod sy’n cyrraedd dy Frenin yn costio hanner bywyd, faint bynnag sy’n mynd trwodd. Os wyt ti’n taflu tywod at yr ateb cywir, mae’n costio bywyd cyfan!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Krabber, der når din Konge, koster et halvt liv, uanset hvor mange der slipper igennem. Kaster du sand på det rigtige svar, koster det et helt liv!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Krabben, die deinen König erreichen, kosten ein halbes Leben – egal, wie viele durchkommen. Wirfst du Sand auf die richtige Antwort, kostet das ein ganzes Leben!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα καβούρια που φτάνουν στον Βασιλιά σου κοστίζουν μισή ζωή, όσα κι αν περάσουν. Αν πετάξεις άμμο στη σωστή απάντηση, χάνεις μια ολόκληρη ζωή!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crabs that reach your King cost half a life, however many of them get through. Throw sand at the right answer and it costs a whole life!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cangrejos que llegan a tu Rey cuestan media vida, no importa cuántos pasen. ¡Si lanzas arena a la respuesta correcta, pierdes una vida entera!"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Krabid, kes jõuavad sinu Kuningani, maksavad pool elu, ükskõik kui palju neist läbi pääseb. Kui viskad liiva õige vastuse pihta, kaotad terve elu!"
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Zure Erregearengana iristen diren karramarroek bizitza erdia kentzen dute, zenbat igarotzen diren axola gabe. Erantzun zuzenari harea botatzen badiozu, bizitza oso bat galduko duzu!"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خرچنگ‌هایی که به پادشاهت می‌رسند نیم جان کم می‌کنند، فرقی نمی‌کند چندتا رد شوند. اگر به جواب درست شن پرتاب کنی، یک جان کامل از دست می‌دهی!"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuninkaasi luo pääsevät ravut vievät puoli elämää riippumatta siitä, montako niitä pääsee läpi. Jos heität hiekkaa oikean vastauksen päälle, menetät kokonaisen elämän!"
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "Krabbar, sum koma fram til Kongin hjá tær, kosta eitt hálvt lív, sama hvussu nógvir sleppa ígjøgnum. Kastar tú sand á rætta svarið, kostar tað eitt heilt lív!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les crabes qui atteignent ton Roi coûtent une demi-vie, quel que soit leur nombre. Si tu lances du sable sur la bonne réponse, tu perds une vie entière !"
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosnaíonn portáin a shroicheann do Rí leathshaol, is cuma cé mhéad a théann tríd. Má chaitheann tú gaineamh ar an bhfreagra ceart, cosnaíonn sé saol iomlán!"
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Os cangrexos que chegan ao teu Rei custan media vida, sen importar cantos pasen. Se botas area á resposta correcta, perdes unha vida enteira!"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા રાજા સુધી પહોંચતા કરચલા અડધી જિંદગી ઘટાડે છે, ભલે કેટલા પસાર થાય. સાચા જવાબ પર રેતી ફેંકશો તો આખી એક જિંદગી ગુમાવશો!"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סרטנים שמגיעים אל המלך עולים בחצי חיים, לא משנה כמה מהם עוברים. אם זורקים חול על התשובה הנכונה, מאבדים חיים שלמים!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो केकड़े तुम्हारे राजा तक पहुँचते हैं, वे आधी जान लेते हैं, चाहे कितने भी निकल जाएँ। अगर तुम सही जवाब पर रेत फेंकोगे, तो पूरी एक जान चली जाएगी!"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakovi koji stignu do tvog Kralja koštaju pola života, bez obzira koliko ih prođe. Ako baciš pijesak na točan odgovor, gubiš cijeli život!"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Királyodhoz eljutó rákok fél életbe kerülnek, akárhányan is jutnak át. Ha a helyes válaszra dobsz homokot, egy egész életet veszítesz!"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քո Թագավորին հասնող խեցգետինները կես կյանք են խլում՝ անկախ նրանից, թե քանիսն են անցնում։ Եթե ավազ նետես ճիշտ պատասխանի վրա, մի ամբողջ կյանք կկորցնես։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kepiting yang sampai ke Rajamu mengurangi setengah nyawa, berapa pun jumlahnya yang lolos. Kalau kamu melempar pasir ke jawaban yang benar, kamu kehilangan satu nyawa penuh!"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Krabbar sem komast til Konungsins þíns kosta hálft líf, sama hversu margir komast í gegn. Ef þú kastar sandi í rétta svarið kostar það heilt líf!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I granchi che raggiungono il tuo Re costano mezza vita, non importa quanti ne passano. Se lanci sabbia alla risposta giusta, perdi una vita intera!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カニが王さままで来ると、何匹通ってもライフは半分減るよ。正しい答えのカニに砂を投げると、ライフが1つ全部減っちゃう！"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კიბორჩხალები, რომლებიც შენს მეფემდე მივლენ, ნახევარ სიცოცხლეს გართმევენ, რამდენიც არ უნდა გავიდეს. თუ სწორ პასუხს ქვიშას ესვრი, მთელ სიცოცხლეს დაკარგავ!"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Патшаңа жеткен шаяндар, қаншасы өтсе де, жарты өмірді алады. Дұрыс жауапқа құм лақтырсаң, бір толық өмірден айырыласың!"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ក្តាមដែលទៅដល់ស្តេចនឹងធ្វើឲ្យបាត់ពាក់កណ្តាលជីវិត មិនថាមានប៉ុន្មានក្បាលឆ្លងកាត់ក៏ដោយ។ បើគប់ខ្សាច់ដាក់ចម្លើយត្រឹមត្រូវ អ្នកនឹងបាត់ជីវិតមួយពេញ!"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿನ್ನ ರಾಜನ ಬಳಿಗೆ ತಲುಪುವ ಏಡಿಗಳು ಎಷ್ಟು ಬಂದರೂ ಅರ್ಧ ಜೀವವನ್ನು ಕಳೆಯುತ್ತವೆ. ಸರಿಯಾದ ಉತ್ತರದ ಮೇಲೆ ಮರಳು ಎಸೆದರೆ ಒಂದು ಪೂರ್ಣ ಜೀವ ಕಳೆದುಕೊಳ್ಳುತ್ತೀಯ!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게가 왕에게 닿으면 몇 마리가 지나가든 생명이 반 칸 줄어요. 정답을 든 게에게 모래를 던지면 생명 한 칸을 잃어요!"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຖ້າປູໄປເຖິງກະສັດ ບໍ່ວ່າຈະຜ່ານໄປຈັກໂຕ ຈະເສຍເຄິ່ງຊີວິດ. ຖ້າປາຊາຍໃສ່ຄຳຕອບທີ່ຖືກ ຈະເສຍຊີວິດໜຶ່ງເຕັມ!"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Krabai, pasiekę tavo Karalių, kainuoja pusę gyvybės, nesvarbu, kiek jų praeina. Jei mesi smėlio į teisingą atsakymą, prarasi visą gyvybę!"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Krabji, kas sasniedz tavu Karali, maksā pusi dzīvības, lai cik daudzi tiktu cauri. Ja metīsi smiltis pareizajai atbildei, zaudēsi veselu dzīvību!"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Раковите што ќе стигнат до твојот Крал чинат половина живот, без разлика колку ќе поминат. Ако фрлиш песок по точниот одговор, губиш цел живот!"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിന്റെ രാജാവിന്റെ അടുത്തെത്തുന്ന ഞണ്ടുകൾ എത്ര എണ്ണം കടന്നാലും അര ജീവൻ കുറക്കും. ശരിയായ ഉത്തരത്തിലേക്ക് മണൽ എറിഞ്ഞാൽ ഒരു മുഴുവൻ ജീവൻ നഷ്ടപ്പെടും!"
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хаанд чинь хүрсэн хавчнууд хэд орсноос үл хамааран хагас амь хасна. Зөв хариу руу элс шидвэл бүтэн нэг амь алдана!"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुझ्या राजापर्यंत पोहोचलेले खेकडे कितीही असले तरी अर्धा जीव कमी करतात. बरोबर उत्तरावर वाळू फेकलीस तर पूर्ण एक जीव जाईल!"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketam yang sampai kepada Raja kamu mengambil setengah nyawa, tidak kira berapa banyak yang lepas. Jika kamu membaling pasir pada jawapan yang betul, kamu kehilangan satu nyawa penuh!"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ကဏန်းတွေ မင်းကြီးဆီ ရောက်သွားရင် ဘယ်နှကောင်ဖြတ်ဖြတ် အသက်တစ်ဝက် လျော့မယ်။ အဖြေမှန်တဲ့ကောင်ကို သဲနဲ့ ပစ်မိရင် အသက်တစ်ခုလုံး ဆုံးရှုံးမယ်!"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Krabber som når Kongen din, koster et halvt liv, uansett hvor mange som slipper gjennom. Kaster du sand på det riktige svaret, koster det et helt liv!"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तिम्रो राजासम्म पुगेका गँगटाहरूले आधा जीवन घटाउँछन्, जति वटा छिरे पनि। सही उत्तरमा बालुवा हानेमा पूरा एउटा जीवन गुम्छ!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krabben die bij je King komen kosten een half leven, ook als er meerdere aankomen. Gooi je zand naar het goede antwoord, dan kost dat een heel leven!"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ତୁମ ରାଜାଙ୍କ ପାଖକୁ ପହଞ୍ଚିଥିବା କଙ୍କଡ଼ାମାନେ ଅଧା ଜୀବନ କମାନ୍ତି, କେତେଟି ପାର ହେଲା ସେଥିରେ କିଛି ଯାଏ ନାହିଁ। ସଠିକ୍ ଉତ୍ତର ଉପରେ ବାଲି ଫିଙ୍ଗିଲେ ପୂରା ଗୋଟିଏ ଜୀବନ ହରାଇବ!"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਿਹੜੇ ਕੇਕੜੇ ਤੇਰੇ ਰਾਜੇ ਤੱਕ ਪਹੁੰਚਦੇ ਹਨ, ਉਹ ਅੱਧੀ ਜ਼ਿੰਦਗੀ ਘਟਾਉਂਦੇ ਹਨ, ਭਾਵੇਂ ਕਿੰਨੇ ਵੀ ਲੰਘ ਜਾਣ। ਜੇ ਸਹੀ ਜਵਾਬ ਉੱਤੇ ਰੇਤ ਸੁੱਟੀ ਤਾਂ ਪੂਰੀ ਇੱਕ ਜ਼ਿੰਦਗੀ ਚਲੀ ਜਾਵੇਗੀ!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kraby, które dotrą do twojego Króla, kosztują pół życia, bez względu na to, ile ich przejdzie. Jeśli rzucisz piaskiem w poprawną odpowiedź, tracisz całe życie!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os caranguejos que chegam ao teu Rei custam meia vida, não importa quantos passem. Se atirares areia à resposta certa, perdes uma vida inteira!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Crabii care ajung la Regele tău costă o jumătate de viață, indiferent câți trec. Dacă arunci cu nisip în răspunsul corect, pierzi o viață întreagă!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Крабы, добравшиеся до Короля, отнимают половину жизни — сколько бы их ни прошло. Если бросишь песком в правильный ответ, потеряешь целую жизнь!"
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔයාගේ රජු ළඟට එන කකුළුවන්, කී දෙනෙක් ආවත්, ජීවිතයෙන් අඩක් අඩු කරනවා. හරි උත්තරයට වැලි විසි කළොත් මුළු ජීවිතයක්ම නැති වෙනවා!"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kraby, ktoré dôjdu ku Kráľovi, stoja pol života, nech ich prejde koľkokoľvek. Ak hodíš piesok na správnu odpoveď, stratíš celý život!"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raki, ki pridejo do tvojega Kralja, stanejo pol življenja, ne glede na to, koliko jih pride skozi. Če vržeš pesek v pravilen odgovor, izgubiš celo življenje!"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaforret që arrijnë te Mbreti yt kushtojnë gjysmë jete, pavarësisht sa kalojnë. Nëse i hedh rërë përgjigjes së saktë, humbet një jetë të plotë!"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ракови који стигну до твог Краља коштају пола живота, без обзира колико их прође. Ако бациш песак на тачан одговор, губиш цео живот!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Krabbor som når din Kung kostar ett halvt liv, oavsett hur många som kommer fram. Kastar du sand på rätt svar kostar det ett helt liv!"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaa wanaofika kwa Mfalme wako hugharimu nusu ya uhai, haijalishi ni wangapi wanapita. Ukirusha mchanga kwenye jibu sahihi, unapoteza uhai mzima!"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உன் ராஜாவை அடையும் நண்டுகள் எத்தனை வந்தாலும் அரை உயிரை குறைக்கும். சரியான பதில்மேல் மணல் எறிந்தால் முழு ஒரு உயிரை இழப்பாய்!"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నీ రాజు దగ్గరకు చేరే పీతలు ఎన్ని వచ్చినా సగం ప్రాణం తగ్గిస్తాయి. సరైన సమాధానంపై ఇసుక విసిరితే ఒక పూర్తి ప్రాణం కోల్పోతావు!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าปูไปถึงพระราชา ไม่ว่าจะผ่านไปกี่ตัว จะเสียชีวิตครึ่งหนึ่ง แต่ถ้าปาทรายใส่คำตอบที่ถูกต้อง จะเสียชีวิตเต็มหนึ่งชีวิต!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kralına ulaşan yengeçler, kaç tane geçerse geçsin, yarım can götürür. Doğru cevaba kum atarsan bir tam can kaybedersin!"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "پادىشاھىڭىزغا يېتىپ بارغان قىسقۇچپاقىلار، قانچىسى ئۆتۈشىدىن قەتئىينەزەر، يېرىم جاننى ئالىدۇ. توغرا جاۋابقا قۇم ئاتسىڭىز، بىر پۈتۈن جاننى يوقىتىسىز!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Краби, що дістануться до Короля, забирають половину життя — скільки б їх не пройшло. Якщо кинеш піском у правильну відповідь, втратиш ціле життя!"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جو کیکڑے تمہارے بادشاہ تک پہنچتے ہیں وہ آدھی جان کم کرتے ہیں، چاہے کتنے ہی گزر جائیں۔ اگر صحیح جواب پر ریت پھینکو گے تو پوری ایک جان چلی جائے گی!"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qirolingga yetib kelgan qisqichbaqalar, nechta o‘tishidan qat’i nazar, yarim jonni oladi. To‘g‘ri javobga qum otsang, bir butun jonni yo‘qotasan!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cua đến được với Đức Vua sẽ làm mất nửa mạng, dù có bao nhiêu con lọt qua. Nếu ném cát vào đáp án đúng, bạn sẽ mất cả một mạng!"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "只要有螃蟹到达国王，不管过去几只，都会扣掉半条命。要是把沙子扔向正确答案，就会扣掉一整条命！"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkalankala ezifinyelela eNkosini yakho zibiza ingxenye yempilo, kungakhathaliseki ukuthi zingaki ezidlulayo. Uma ujikijela isihlabathi empendulweni elungile, ulahlekelwa impilo yonke!"
          }
        }
      }
    },
    "tutorial.step.4": {
      "comment": "Walkthrough step 4 of 10: the pink helper crab, which carries an extra life to the King. Spoken to a young child, one or two short sentences.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hierdie pienk krap bring vir jou Koning ’n ekstra lewe. Tik daarop en hy dra die hart reguit na hom toe!"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ይህ ሮዝ ሸርጣን ለንጉሥህ ተጨማሪ ሕይወት እያመጣ ነው። ነካ አድርገውና ልቡን በቀጥታ ወደ ንጉሥህ ያድርስ!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا السلطعون الوردي يحمل حياة إضافية إلى ملكك. اضغط عليه ليحمل القلب مباشرة إليه!"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "এই গোলাপী কেঁকোৰাই তোমাৰ ৰজাৰ বাবে এটা অতিৰিক্ত জীৱন লৈ আহিছে। ইয়াত টেপ কৰা, ই হৃদয়টো পোনে পোনে ৰজাৰ ওচৰলৈ লৈ যাব!"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu çəhrayı xərçəng Kralına əlavə can gətirir. Ona toxun və ürəyi düz Kralına aparsın!"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэты ружовы краб нясе твайму Каралю дадатковае жыццё. Націсні на яго, і ён даставіць сэрцайка проста да Караля!"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този розов рак носи допълнителен живот на твоя Крал. Докосни го и той ще занесе сърцето право при него!"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই গোলাপি কাঁকড়াটি তোমার রাজার জন্য একটি বাড়তি জীবন আনছে। এটিতে ট্যাপ করো, তাহলে হৃদয়টি সরাসরি রাজার কাছে নিয়ে যাবে!"
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "སྡིག་སྲིན་རྩི་མདོག་འདིས་རྒྱལ་པོར་སྲོག་གཅིག་ཁ་སྣོན་ཁྱེར་ཡོང་གི་འདུག དེ་མནན་ན་སྙིང་དེ་ཐད་ཀར་རྒྱལ་པོའི་རྩར་ཁྱེར་འགྲོ།"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj ružičasti rak donosi tvom Kralju dodatni život. Dodirni ga i odnijet će srce pravo do njega!"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest cranc rosa porta una vida extra al teu Rei. Toca’l i li durà el cor directament!"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenhle růžový krab nese tvému Králi život navíc. Klepni na něj a donese mu srdce až k němu!"
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae’r cranc pinc hwn yn dod â bywyd ychwanegol i dy Frenin. Tapia fo a bydd yn cario’r galon ato!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lyserøde krabbe kommer med et ekstra liv til din Konge. Tryk på den, så bærer den hjertet hele vejen hen til ham!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese rosa Krabbe bringt deinem König ein Extraleben. Tippe auf sie, dann trägt sie das Herz direkt zu ihm!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το ροζ καβούρι φέρνει μια έξτρα ζωή στον Βασιλιά σου. Πάτησέ το και θα του πάει την καρδιά κατευθείαν!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This pink crab is bringing your King an extra life. Tap it and it carries the heart right over to him!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este cangrejo rosa lleva una vida extra a tu Rey. Tócalo y llevará el corazón directamente hasta él."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See roosa krabi toob sinu Kuningale ühe lisaelu. Puuduta teda ja ta kannab südame otse Kuningani!"
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Karramarro arrosa honek bizitza gehigarri bat darama zure Erregearentzat. Ukitu eta bihotza zuzenean eramango dio!"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این خرچنگ صورتی برای پادشاهت یک جان اضافه می‌آورد. روی آن بزن تا قلب را مستقیم به او برساند!"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä vaaleanpunainen rapu tuo Kuninkaallesi lisäelämän. Napauta sitä, niin se vie sydämen suoraan hänelle!"
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesin ljósareyði krabbin kemur við einum eyka lívi til Kongin hjá tær. Trýst á hann, so ber hann hjartað beinleiðis til hansara!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce crabe rose apporte une vie en plus à ton Roi. Touche-le et il lui portera le cœur !"
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá an portán bándearg seo ag tabhairt saol breise do do Rí. Tapáil é agus iompróidh sé an croí díreach chuige!"
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Este cangrexo rosa leva unha vida extra ao teu Rei. Tócao e levaralle o corazón directamente!"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ગુલાબી કરચલો તમારા રાજા માટે એક વધારાની જિંદગી લાવે છે. તેને ટૅપ કરો અને તે હૃદય સીધું રાજા સુધી લઈ જશે!"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסרטן הוורוד הזה מביא למלך חיים נוספים. נוגעים בו והוא נושא את הלב ישר אליו!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह गुलाबी केकड़ा तुम्हारे राजा के लिए एक अतिरिक्त जान ला रहा है। इसे टैप करो और यह दिल सीधे राजा तक पहुँचा देगा!"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj ružičasti rak nosi tvom Kralju dodatni život. Dodirni ga i odnijet će srce ravno do njega!"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a rózsaszín rák egy extra életet visz a Királyodnak. Koppints rá, és egyenesen elviszi hozzá a szívet!"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս վարդագույն խեցգետինը լրացուցիչ կյանք է տանում քո Թագավորին։ Հպիր նրան, և նա սիրտը կտանի ուղիղ Թագավորին։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kepiting merah muda ini membawa satu nyawa tambahan untuk Rajamu. Ketuk dia dan dia akan membawa hati itu langsung ke Rajamu!"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þessi bleiki krabbi færir Konunginum þínum aukalíf. Pikkaðu á hann og hann ber hjartað beint til hans!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo granchio rosa sta portando una vita extra al tuo Re. Toccalo e porterà il cuore dritto da lui!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このピンクのカニは王さまにライフを1つ届けてくれるよ。タップすると、ハートをまっすぐ王さまのところへ運んでくれる！"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ვარდისფერ კიბორჩხალას შენს მეფესთან დამატებითი სიცოცხლე მოაქვს. შეეხე და ის გულს პირდაპირ მეფეს მიუტანს!"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл қызғылт шаян Патшаңа қосымша өмір алып келеді. Оны түрт, сонда жүректі тура Патшаңа жеткізеді!"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ក្តាមពណ៌ផ្កាឈូកនេះកំពុងនាំជីវិតបន្ថែមមួយទៅឲ្យស្តេច។ ប៉ះវា ហើយវានឹងនាំបេះដូងទៅដល់ស្តេចផ្ទាល់!"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಗುಲಾಬಿ ಏಡಿ ನಿನ್ನ ರಾಜನಿಗೆ ಒಂದು ಹೆಚ್ಚುವರಿ ಜೀವ ತರುತ್ತಿದೆ. ಅದನ್ನು ಟ್ಯಾಪ್ ಮಾಡು, ಅದು ಹೃದಯವನ್ನು ನೇರವಾಗಿ ರಾಜನಿಗೆ ತಲುಪಿಸುತ್ತದೆ!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 분홍색 게는 왕에게 생명 한 칸을 더 가져다줘요. 탭하면 하트를 왕에게 바로 가져가요!"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ປູສີບົວໂຕນີ້ກຳລັງນຳຊີວິດເພີ່ມໄປໃຫ້ກະສັດ. ແຕະມັນ ແລ້ວມັນຈະນຳຫົວໃຈໄປຫາກະສັດໂດຍກົງ!"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis rožinis krabas neša tavo Karaliui papildomą gyvybę. Paliesk jį ir jis nuneš širdelę tiesiai Karaliui!"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis rozā krabis nes tavam Karalim papildu dzīvību. Pieskaries tam, un tas aiznesīs sirsniņu tieši pie Karaļa!"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Овој розов рак му носи дополнителен живот на твојот Крал. Допри го и ќе му го однесе срцето право до него!"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ പിങ്ക് ഞണ്ട് നിന്റെ രാജാവിന് ഒരു അധിക ജീവൻ കൊണ്ടുവരുന്നു. അതിനെ ടാപ്പ് ചെയ്യൂ, ഹൃദയം നേരെ രാജാവിന്റെ അടുത്തേക്ക് കൊണ്ടുപോകും!"
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ ягаан хавч Хаанд чинь нэмэлт амь авчирч байна. Түүн дээр товшоод, зүрхийг шууд Хаанд чинь хүргэ!"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा गुलाबी खेकडा तुझ्या राजासाठी एक जादा जीव आणतोय. त्याच्यावर टॅप कर आणि तो हृदय थेट राजापर्यंत नेईल!"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketam merah jambu ini membawa satu nyawa tambahan untuk Raja kamu. Ketik padanya dan ia akan membawa hati terus kepada Raja!"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဒီပန်းရောင်ကဏန်းက မင်းကြီးအတွက် အပိုအသက်တစ်ခု ယူလာတယ်။ တို့လိုက်ရင် နှလုံးကို မင်းကြီးဆီ တန်းပို့ပေးမယ်!"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne rosa krabben kommer med et ekstra liv til Kongen din. Trykk på den, så bærer den hjertet helt fram til ham!"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो गुलाबी गँगटोले तिम्रो राजाका लागि थप एउटा जीवन ल्याउँदैछ। यसमा ट्याप गर र यसले मुटु सिधै राजासम्म पुर्‍याउँछ!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze roze krab brengt je King een extra leven. Tik hem aan, dan brengt hij het hartje naar hem toe!"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ଗୋଲାପୀ କଙ୍କଡ଼ା ତୁମ ରାଜାଙ୍କ ପାଇଁ ଗୋଟିଏ ଅତିରିକ୍ତ ଜୀବନ ଆଣୁଛି। ଏହାକୁ ଟ୍ୟାପ୍ କର, ଏହା ହୃଦୟଟି ସିଧା ରାଜାଙ୍କ ପାଖକୁ ନେଇଯିବ!"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਗੁਲਾਬੀ ਕੇਕੜਾ ਤੇਰੇ ਰਾਜੇ ਲਈ ਇੱਕ ਵਾਧੂ ਜ਼ਿੰਦਗੀ ਲਿਆ ਰਿਹਾ ਹੈ। ਇਸਨੂੰ ਟੈਪ ਕਰ ਅਤੇ ਇਹ ਦਿਲ ਸਿੱਧਾ ਰਾਜੇ ਤੱਕ ਲੈ ਜਾਵੇਗਾ!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten różowy krab niesie twojemu Królowi dodatkowe życie. Dotknij go, a zaniesie serce prosto do niego!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este caranguejo cor-de-rosa leva uma vida extra ao teu Rei. Toca nele e ele leva o coração direitinho até ao Rei!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest crab roz îi aduce Regelui tău o viață în plus. Atinge-l și va duce inima direct la el!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот розовый краб несёт твоему Королю дополнительную жизнь. Нажми на него, и он доставит сердечко прямо Королю!"
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "මේ රෝස කකුළුවා ඔයාගේ රජුට අමතර ජීවිතයක් ගෙන එනවා. ඒකට ටැප් කරන්න, එයා හදවත කෙළින්ම රජු ළඟට ගෙන යයි!"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento ružový krab nesie tvojmu Kráľovi život navyše. Ťukni naň a donesie mu srdce priamo k nemu!"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta rožnati rak tvojemu Kralju prinaša dodatno življenje. Tapni ga in srce bo odnesel naravnost do njega!"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjo gaforre rozë po i sjell Mbretit tënd një jetë shtesë. Preke dhe do t’ia çojë zemrën drejt e atij!"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Овај ружичасти рак носи твом Краљу додатни живот. Додирни га и однеће срце право до њега!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här rosa krabban kommer med ett extra liv till din Kung. Tryck på den så bär den hjärtat hela vägen fram till honom!"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaa huyu wa waridi anamletea Mfalme wako uhai wa ziada. Mguse na atapeleka moyo moja kwa moja kwake!"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த இளஞ்சிவப்பு நண்டு உன் ராஜாவுக்கு ஒரு கூடுதல் உயிரை கொண்டு வருகிறது. அதைத் தட்டு, அது இதயத்தை நேராக ராஜாவிடம் கொண்டு செல்லும்!"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ గులాబీ పీత నీ రాజుకు ఒక అదనపు ప్రాణం తీసుకొస్తోంది. దానిపై ట్యాప్ చేయి, అది గుండెను నేరుగా రాజు దగ్గరకు తీసుకెళ్తుంది!"
          }
        },
        "th": {
