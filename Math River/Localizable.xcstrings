    "streak.accessibility.choosePeriod": {
      "comment": "VoiceOver hint for the streak chip, saying that tapping it opens the play-goal sheet.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies ’n daaglikse of weeklikse doel"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የቀን ወይም የሳምንት ግብ ምረጥ"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر هدفًا يوميًا أو أسبوعيًا"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "দৈনিক বা সাপ্তাহিক লক্ষ্য বাছা"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Gündəlik və ya həftəlik hədəf seç"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
