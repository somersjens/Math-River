    "settings.goalInfo %lld": {
      "comment": "Footnote under the play goals. The argument is the daily goal a new player starts with, in minutes — always 5, so write the plural form; it is never one.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die reeksdoel begin by %lld minute per dag. Net aktiewe speeltyd tel."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የተከታታይ ጨዋታ ግብ በቀን %lld ደቂቃዎች ይጀምራል። የእውነት የተጫወትክበት ጊዜ ብቻ ይቆጠራል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هدف السلسلة يبدأ من %lld دقائق يوميًا. يُحسب وقت اللعب الفعلي فقط."
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "ষ্ট্ৰিকৰ লক্ষ্য প্ৰতিদিনে %lld মিনিটৰ পৰা আৰম্ভ হয়। কেৱল খেলি থকা সময় গণনা হয়।"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Seriya hədəfi gündə %lld dəqiqə ilə başlayır. Yalnız aktiv oyun vaxtı sayılır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мэта серыі пачынаецца з %lld хвілін у дзень. Лічыцца толькі час актыўнай гульні."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Целта за серията започва с %lld минути на ден. Брои се само активната игра."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ট্রিকের লক্ষ্য প্রতিদিন %lld মিনিটের দিয়ে শুরু হয়। শুধু খেলায় সক্রিয় সময়ই ধরা হয়।"
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "ཉིན་རེའི་བསྟུད་མའི་དམིགས་ཡུལ་སྐར་མ་ %lld ནས་འགོ་ཚུགས། རྩེད་མོ་རྩེ་བཞིན་པའི་དུས་ཚོད་ཁོ་ན་བརྩི།"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cilj niza počinje na %lld minuta dnevno. Računa se samo aktivna igra."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’objectiu de ratxa comença amb %lld minuts al dia. Només compta el temps de joc actiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cíl série začíná na %lld minut denně. Počítá se jen aktivní hraní."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae nod y gyfres yn dechrau ar %lld munud y dydd. Dim ond amser chwarae gweithredol sy’n cyfrif."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Seriemålet starter på %lld minutter om dagen. Kun aktiv spilletid tæller."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Serienziel beginnt bei %lld Minuten pro Tag. Nur aktive Spielzeit zählt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο στόχος σερί ξεκινά από %lld λεπτά τη μέρα. Μετρά μόνο ο χρόνος που παίζεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The streak goal starts at %lld minutes per day. Only active playtime counts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El objetivo de racha empieza en %lld minutos al día. Solo cuenta el tiempo de juego activo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seeria eesmärk algab %lld minutit päevas. Arvesse läheb ainult aktiivne mänguaeg."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Segidaren helburua eguneko %lld minutuz-rekin hasten da. Jolas aktiboa bakarrik zenbatzen da."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هدف زنجیره از روزی %lld دقیقه شروع می‌شود. فقط زمان بازی فعال حساب می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Putkitavoite alkaa %lld minuuttia päivässä. Vain aktiivinen peliaika lasketaan."
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "Raðmálið byrjar við %lld minuttir um dagin. Bara virkin spælitíð telur."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’objectif de série commence à %lld minutes par jour. Seul le temps de jeu actif compte."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tosaíonn sprioc na sraithe ag %lld nóiméad sa lá. Ní áirítear ach am gníomhach imeartha."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "O obxectivo da serie comeza en %lld minutos ao día. Só conta o tempo de xogo activo."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્ટ્રીક લક્ષ્ય દરરોજ %lld મિનિટથી શરૂ થાય છે. ફક્ત રમવાનો સમય ગણાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יעד הרצף מתחיל ב-%lld דקות ליום. רק זמן משחק פעיל נחשב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्ट्रीक लक्ष्य रोज़ %lld मिनट से शुरू होता है। सिर्फ खेलने का समय गिना जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cilj niza počinje s %lld minuta dnevno. Broji se samo aktivna igra."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A sorozatcél napi %lld percet értékről indul. Csak az aktív játékidő számít."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Շարքի նպատակը սկսվում է օրական %lld րոպե-ից։ Հաշվվում է միայն ակտիվ խաղաժամանակը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Target beruntun mulai dari %lld menit per hari. Hanya waktu bermain aktif yang dihitung."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Runumarkmiðið byrjar á %lld mínútur á dag. Aðeins virkur leiktími telur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'obiettivo serie parte da %lld minuti al giorno. Conta solo il tempo di gioco attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連続プレイの目標は1日%lld分から始まります。遊んでいる時間だけがカウントされます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სერიის მიზანი იწყება დღეში %lld წუთის-ით. ითვლება მხოლოდ აქტიური თამაშის დრო."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Серия мақсаты күніне %lld минут-тан басталады. Тек белсенді ойын уақыты саналады."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គោលដៅនៃការលេងជាប់ៗគ្នាចាប់ផ្តើមពី %lld នាទីក្នុងមួយថ្ងៃ។ គិតតែពេលលេងសកម្មប៉ុណ្ណោះ។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಟ್ರೀಕ್ ಗುರಿ ದಿನಕ್ಕೆ %lld ನಿಮಿಷಗಳರಿಂದ ಆರಂಭವಾಗುತ್ತದೆ. ಆಡಿದ ಸಮಯ ಮಾತ್ರ ಎಣಿಕೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연속 목표는 하루 %lld 분부터 시작해요. 실제 플레이 시간만 포함돼요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເປົ້າໝາຍການຫຼິ້ນຕິດຕໍ່ກັນເລີ່ມທີ່ %lld ນາທີຕໍ່ມື້. ນັບແຕ່ເວລາຫຼິ້ນຈິງເທົ່ານັ້ນ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Serijos tikslas prasideda nuo %lld minučių per dieną. Skaičiuojamas tik aktyvus žaidimas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sērijas mērķis sākas ar %lld minūtes dienā. Skaita tikai aktīvo spēles laiku."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Целта за низа почнува со %lld минути дневно. Се брои само активното играње."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്റ്റ്രീക്ക് ലക്ഷ്യം ദിവസവും %lld മിനിറ്റ് ആയി തുടങ്ങും. കളിച്ച സമയം മാത്രം കണക്കാക്കും."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Дарааллын зорилго өдөрт %lld минут-оос эхэлнэ. Зөвхөн тоглосон хугацаа тооцогдоно."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सलग खेळाचे लक्ष्य रोज %lld मिनिटे पासून सुरू होते. फक्त खेळलेला वेळ मोजला जातो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sasaran rentetan bermula pada %lld minit sehari. Hanya masa bermain aktif dikira."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဆက်တိုက်ကစားရည်မှန်းချက်က တစ်နေ့ %lld မိနစ်က စတယ်။ ကစားနေတဲ့အချိန်ပဲ တွက်တယ်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekkemålet starter på %lld minutter per dag. Bare aktiv spilletid teller."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "स्ट्रीक लक्ष्य दिनको %lld मिनेटको बाट सुरु हुन्छ। सक्रिय खेल समय मात्र गनिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het streakdoel begint bij %lld minuten per dag. Alleen actieve speeltijd telt mee."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଷ୍ଟ୍ରିକ୍ ଲକ୍ଷ୍ୟ ଦିନକୁ %lld ମିନିଟ୍ ରୁ ଆରମ୍ଭ। କେବଳ ଖେଳିଥିବା ସମୟ ଗଣାଯାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਲੜੀ ਦਾ ਟੀਚਾ ਰੋਜ਼ %lld ਮਿੰਟ ਤੋਂ ਸ਼ੁਰੂ ਹੁੰਦਾ ਹੈ। ਸਿਰਫ਼ ਖੇਡਣ ਦਾ ਅਸਲ ਸਮਾਂ ਗਿਣਿਆ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cel serii zaczyna się od %lld minut dziennie. Liczy się tylko aktywna gra."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O objetivo da sequência começa em %lld minutos por dia. Só conta o tempo em que jogas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ținta seriei începe cu %lld minute pe zi. Contează doar jocul activ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цель серии начинается с %lld минут в день. Считается только время игры."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "එක දිගට ක්‍රීඩා කිරීමේ ඉලක්කය දිනකට මිනිත්තු %lldකින් ආරම්භ වේ. සක්‍රීයව ක්‍රීඩා කරන වේලාව පමණක් ගණන් ගනී."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Denný cieľ série je %lld minút. Počíta sa len aktívny čas hry."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Začetni dnevni cilj v minutah: %lld minut. Šteje le aktivno igranje."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Synimi i serisë nis me %lld minuta në ditë. Llogaritet vetëm koha aktive e lojës."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cilj za niz počinje sa %lld минута dnevno. Računa se samo aktivno igranje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Seriemålet börjar på %lld minuter per dag. Bara aktiv speltid räknas."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Lengo la mfululizo linaanza kwa dakika %lld kwa siku. Ni muda wa kucheza tu ndio unaohesabiwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடர் இலக்கு நாளுக்கு %lld నిమిషాలు என்று தொடங்கும். விளையாடும் நேரம் மட்டும் கணக்காகும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రోజువారీ స్ట్రీక్ లక్ష్యం %lld నిమిషాలుతో మొదలవుతుంది. ఆడిన సమయం మాత్రమే లెక్క."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป้าหมายการเล่นต่อเนื่องเริ่มที่ %lld นาทีต่อวัน นับเฉพาะเวลาที่เล่นจริง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seri hedefi günde %lld dakika ile başlar. Sadece aktif oyun süresi sayılır."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "كۈندىلىك نىشان: %lld مىنۇت. پەقەت ھەقىقىي ئوينىغان ۋاقتىڭ ھېسابلىنىدۇ."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоденна ціль серії — %lld хвилин. Рахується лише активна гра."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "روزانہ کا اسٹریک ہدف %lld منٹ سے شروع ہوتا ہے۔ صرف کھیلنے کا اصل وقت شمار ہوتا ہے۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Seriya maqsadi kuniga %lld daqiqadan boshlanadi. Faqat faol o‘yin vaqti hisoblanadi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mục tiêu chuỗi bắt đầu ở %lld phút mỗi ngày. Chỉ tính thời gian chơi thực tế."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "连续目标从每天 %lld 分钟开始。只计算实际游戏时间。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Umgomo wochungechunge uqala ngemizuzu engu-%lld ngosuku. Kubalwa isikhathi sokudlala kuphela."
          }
        }
      }
    },
