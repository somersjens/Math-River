    "onboarding.name.subtitle": {
      "comment": "Line under the first onboarding headline, leading into the name field.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom ons begin. Wat is jou naam?"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "እንጀምር። ስምህ ማን ነው?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لنبدأ. ما اسمك؟"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "আৰম্ভ কৰোঁ আহা। তোমাৰ নাম কি?"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlayaq. Adın nədir?"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пачнём! Як цябе завуць?"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Да започваме. Как се казваш?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চলো শুরু করি। তোমার নাম কী?"
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "ད་འགོ་འཛུགས། ཁྱེད་ཀྱི་མིང་ལ་ག་རེ་ཟེར།"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počnimo. Kako se zoveš?"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comencem. Com et dius?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jdeme na to. Jak se jmenuješ?"
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Dewch i ddechrau. Beth yw dy enw?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lad os begynde. Hvad hedder du?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Los geht’s. Wie heißt du?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ας ξεκινήσουμε. Πώς σε λένε;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's get started. What's your name?"
