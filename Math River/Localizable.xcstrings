            "value": "%1$@, dakika %2$lld kati ya %3$lld, siku %4$lld mfululizo"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %3$lld நிமிடங்களில் %2$lld, தொடர்ந்து %4$lld நாட்கள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %3$lld నిమిషాల్లో %2$lld, వరుసగా %4$lld రోజులు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$lld จาก %3$lld นาที, ต่อเนื่อง %4$lld วัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$lld/%3$lld dakika, üst üste %4$lld gün"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@، %3$lld مىنۇتنىڭ %2$lld، ئۇدا %4$lld كۈن"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$lld із %3$lld хвилин, %4$lld днів поспіль"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@، %3$lld میں سے %2$lld منٹ، لگاتار %4$lld دن"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %3$lld daqiqadan %2$lld daqiqa, ketma-ket %4$lld kun"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$lld trên %3$lld phút, %4$lld ngày liên tiếp"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，%2$lld/%3$lld 分钟，连续 %4$lld 天"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$lld kwemizuzu engu-%3$lld, izinsuku ezingu-%4$lld zilandelana"
          }
        }
      }
    },
