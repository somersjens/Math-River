    "premium.feature.animals.subtitle %lld": {
      "comment": "Explains the second Premium selling point. The argument is the total number of animals in the game — always 10, so write the plural form; it is never one.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
