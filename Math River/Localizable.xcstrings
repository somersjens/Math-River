    "notif.comeback.body": {
      "comment": "Push notification body after a long absence. Warm, never guilt-inducing.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou diere wag. Spring weer in en hou aan om skulpe te versamel!"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "እንስሳትህ እየጠበቁህ ነው። ወደ ጨዋታው ተመለስና ዛጎሎችን መሰብሰብህን ቀጥል!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حيواناتك تنتظرك. عد إلى اللعب وواصل جمع الأصداف!"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমাৰ জন্তুবোৰে অপেক্ষা কৰি আছে। খেললৈ উভতি আহা আৰু শামুকৰ খোলা সংগ্ৰহ কৰি থাকা!"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Heyvanların səni gözləyir. Oyuna qayıt və dəniz qabıqları toplamağa davam et!"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Твае звяркі чакаюць. Вяртайся ў гульню і працягвай збіраць ракавінкі!"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Твоите животни те чакат. Върни се в играта и продължи да събираш миди!"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমার প্রাণীরা অপেক্ষা করছে। আবার খেলায় ফিরে এসে ঝিনুক সংগ্রহ করতে থাকো!"
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "ཁྱོད་ཀྱི་སྲོག་ཆགས་ཚོས་སྒུག་བསྡད་ཡོད། རྩེད་མོར་ཕྱིར་ལོག་ནས་ཉ་ཕྱིས་མུ་མཐུད་བསྡུས།"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje životinje čekaju. Vrati se u igru i nastavi prikupljati školjke!"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els teus animals t’esperen. Torna a jugar i continua recollint petxines!"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje zvířátka čekají. Vrať se do hry a pokračuj ve sbírání mušlí!"
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae dy anifeiliaid yn aros. Neidia’n ôl i mewn a dal ati i gasglu cregyn!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine dyr venter. Hop ind igen, og bliv ved med at samle muslinger!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Tiere warten schon. Spring wieder rein und sammle weiter Muscheln!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα ζωάκια σου περιμένουν. Μπες ξανά στο παιχνίδι και συνέχισε να μαζεύεις κοχύλια!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your animals are waiting. Jump back in and keep collecting shells!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus animales te esperan. ¡Vuelve al juego y sigue recogiendo conchas!"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu loomad ootavad. Hüppa mängu tagasi ja jätka merekarpide kogumist!"
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Zure animaliak zain dituzu. Itzuli jokora eta jarraitu maskorrak biltzen!"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حیوان‌هایت منتظرند. دوباره وارد بازی شو و به جمع کردن صدف‌ها ادامه بده!"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Eläimesi odottavat. Hyppää takaisin peliin ja jatka simpukoiden keräämistä!"
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "Djórini hjá tær bíða. Far inn aftur og halt fram at savna skel!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes animaux t’attendent. Reviens jouer et continue à ramasser des coquillages !"
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá d’ainmhithe ag fanacht. Léim isteach arís agus lean ort ag bailiú blaoscanna!"
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Os teus animais están agardando. Volve ao xogo e segue recollendo cunchas!"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા પ્રાણીઓ રાહ જોઈ રહ્યા છે. ફરી રમતમાં આવો અને છીપો ભેગી કરતા રહો!"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החיות שלך מחכות. חוזרים למשחק וממשיכים לאסוף צדפות!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हारे जानवर इंतज़ार कर रहे हैं। फिर से खेलो और सीपियाँ इकट्ठी करते रहो!"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje životinje čekaju. Vrati se u igru i nastavi skupljati školjke!"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az állataid várnak. Ugorj vissza a játékba, és gyűjts tovább kagylókat!"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քո կենդանիները սպասում են։ Վերադարձիր խաղ և շարունակիր խեցիներ հավաքել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hewan-hewanmu sedang menunggu. Ayo main lagi dan lanjutkan mengumpulkan kerang!"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Dýrin þín bíða. Hoppaðu aftur inn og haltu áfram að safna skeljum!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi animali ti aspettano. Torna a giocare e continua a raccogliere conchiglie!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どうぶつたちが待っているよ。また遊んで、貝がらを集めよう！"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შენი ცხოველები გელოდებიან. დაბრუნდი თამაშში და გააგრძელე ნიჟარების შეგროვება!"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жануарларың күтіп отыр. Ойынға қайта кіріп, бақалшақ жинауды жалғастыр!"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សត្វរបស់អ្នកកំពុងរង់ចាំ។ ត្រឡប់មកលេងវិញ ហើយបន្តប្រមូលសំបកខ្យង!"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿನ್ನ ಪ್ರಾಣಿಗಳು ಕಾಯುತ್ತಿವೆ. ಮತ್ತೆ ಆಟಕ್ಕೆ ಬಂದು ಚಿಪ್ಪುಗಳನ್ನು ಸಂಗ್ರಹಿಸುತ್ತಿರು!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동물 친구들이 기다리고 있어요. 다시 들어와 조개껍데기를 계속 모아 보세요!"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ສັດຂອງເຈົ້າກຳລັງລໍຖ້າ. ກັບມາຫຼິ້ນ ແລະເກັບເປືອກຫອຍຕໍ່ໄປ!"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavo gyvūnėliai laukia. Grįžk į žaidimą ir toliau rink kriaukles!"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavi dzīvnieciņi gaida. Atgriezies spēlē un turpini vākt gliemežvākus!"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твоите животни чекаат. Врати се во играта и продолжи да собираш школки!"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിന്റെ മൃഗങ്ങൾ കാത്തിരിക്കുന്നു. വീണ്ടും കളിക്കൂ, ചിപ്പികൾ ശേഖരിച്ചുകൊണ്ടിരിക്കുക!"
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Амьтад чинь хүлээж байна. Тоглоомдоо буцаж ороод хясаагаа үргэлжлүүлэн цуглуулаарай!"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुझे प्राणी वाट पाहत आहेत. पुन्हा खेळात ये आणि शिंपले गोळा करत राहा!"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Haiwan kamu sedang menunggu. Masuk semula dan teruskan mengumpul cangkerang!"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "မင်းရဲ့ တိရစ္ဆာန်လေးတွေ စောင့်နေကြတယ်။ ပြန်ကစားပြီး ခရုခွံတွေ ဆက်စုဆောင်းရအောင်!"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyrene dine venter. Hopp inn igjen og fortsett å samle skjell!"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तिम्रा जनावरहरू पर्खिरहेका छन्। फेरि खेलमा आऊ र सिपीहरू सङ्कलन गर्दै जाऊ!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je dieren wachten op je. Spring weer verder en verzamel meer schelpen!"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ତୁମର ପ୍ରାଣୀମାନେ ଅପେକ୍ଷା କରୁଛନ୍ତି। ପୁଣି ଖେଳକୁ ଫେରି ଶାମୁକା ଖୋଳ ସଂଗ୍ରହ କରିଚାଲ!"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੇਰੇ ਜਾਨਵਰ ਉਡੀਕ ਰਹੇ ਹਨ। ਮੁੜ ਗੇਮ ਵਿੱਚ ਆ ਅਤੇ ਸੀਪੀਆਂ ਇਕੱਠੀਆਂ ਕਰਦਾ ਰਹਿ!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje zwierzaki czekają. Wróć do gry i zbieraj dalej muszle!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os teus animais estão à espera. Volta ao jogo e continua a apanhar conchas!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Animalele tale te așteaptă. Intră din nou în joc și continuă să aduni scoici!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твои зверята ждут. Возвращайся в игру и продолжай собирать ракушки!"
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔයාගේ සත්තු බලාගෙන ඉන්නවා. ආයෙත් ක්‍රීඩාවට එන්න, සිප්පි කටු එකතු කරගෙන යන්න!"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje zvieratká čakajú. Vráť sa do hry a zbieraj ďalej mušle!"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje živali čakajo. Vrni se v igro in nadaljuj z zbiranjem školjk!"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kafshët e tua po presin. Hyr përsëri në lojë dhe vazhdo të mbledhësh guaska!"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Твоје животиње чекају. Врати се у игру и настави да сакупљаш шкољке!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina djur väntar. Hoppa in igen och fortsätt samla snäckor!"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanyama wako wanasubiri. Rudi kwenye mchezo na uendelee kukusanya magamba!"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உன் விலங்குகள் காத்திருக்கின்றன. மீண்டும் விளையாடி சிப்பிகளை தொடர்ந்து சேகரி!"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నీ జంతువులు ఎదురుచూస్తున్నాయి. మళ్లీ ఆటలోకి వచ్చి గవ్వలు సేకరిస్తూ ఉండు!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เหล่าสัตว์ของคุณกำลังรออยู่ กลับมาเล่นแล้วเก็บเปลือกหอยต่อกันเถอะ!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hayvanların seni bekliyor. Oyuna dön ve deniz kabuklarını toplamaya devam et!"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "ھايۋانلىرىڭىز سىزنى ساقلاۋاتىدۇ. ئويۇنغا قايتىپ، دېڭىز قېپى يىغىشنى داۋاملاشتۇرۇڭ!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твої звірята чекають. Повертайся до гри й продовжуй збирати мушлі!"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمہارے جانور انتظار کر رہے ہیں۔ دوبارہ کھیل میں آؤ اور سیپیاں جمع کرتے رہو!"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hayvonlaring seni kutyapti. O‘yinga qaytib, chig‘anoq yig‘ishda davom et!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bạn thú đang chờ bạn. Quay lại chơi và tiếp tục nhặt vỏ sò nhé!"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你的动物伙伴们在等你。回来继续收集贝壳吧！"
          }
        },
        "zu": {
