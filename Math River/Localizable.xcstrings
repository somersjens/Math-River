    "settings.soundInfo": {
      "comment": "Footnote under the audio switches, reassuring the player that muting changes nothing about the game.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skakel die klank af om stil te speel. Die speletjie werk presies dieselfde."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በጸጥታ ለመጫወት ድምፁን አጥፋ። ጨዋታው እንደበፊቱ ይሰራል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقف الصوت لتلعب بهدوء. اللعبة تعمل بالطريقة نفسها."
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "নিশব্দে খেলিবলৈ শব্দ বন্ধ কৰা। খেলখন একেই ধৰণে চলিব।"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakit oynamaq üçün səsi söndür. Oyun yenə eyni işləyir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключы гук, каб гуляць ціха. Гульня будзе працаваць гэтак жа."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изключи звука за тиха игра. Играта си остава същата."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চুপচাপ খেলতে শব্দ বন্ধ করো। খেলাটি একইভাবে চলবে।"
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "ཁུ་སིམ་པོར་རྩེ་བར་སྒྲ་ཁ་རྒྱོབ། རྩེད་མོ་འདྲ་མཚུངས་སུ་འགྲོ།"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Isključi zvuk za tihu igru. Igra radi potpuno isto."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva el so per jugar en silenci. El joc funciona igual."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypni zvuk a hraj potichu. Hra funguje úplně stejně."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Diffodd y sain i chwarae’n dawel. Mae’r gêm yn gweithio yn union yr un fath."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå lyden fra for at spille stille. Spillet fungerer helt på samme måde."
          }
        },
        "de": {
          "stringUnit": {
