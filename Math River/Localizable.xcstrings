    "tutorial.step.1": {
      "comment": "Walkthrough step 1 of 10: only wrong answers walk in, and tapping one costs nothing yet. Spoken to a young child, one or two short sentences.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkeerde antwoorde marsjeer na jou Koning toe! Tik op ’n krap om sand na hom te gooi. Kry hulle almal weg!"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የተሳሳቱ መልሶች ወደ ንጉሥህ እየመጡ ነው! ሸርጣንን ነካ አድርገህ አሸዋ ወርውርበት። ሁሉንም አስወግድ!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإجابات الخاطئة تتجه نحو ملكك! اضغط على سلطعون لترمي عليه الرمل. أبعدها كلها!"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "ভুল উত্তৰবোৰ তোমাৰ ৰজাৰ ফালে আহি আছে! এটা কেঁকোৰাত টেপ কৰি তাৰ ফালে বালি ছটিয়াওক। সকলো আঁতৰাই দিয়া!"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Səhv cavablar Kralına doğru irəliləyir! Bir xərçəngə toxun və ona qum at. Hamısını təmizlə!"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Няправільныя адказы ідуць да твайго Караля! Націсні на краба, каб кінуць у яго пяском. Прыбяры іх усіх!"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Грешните отговори маршируват към твоя Крал! Докосни рак, за да хвърлиш пясък по него. Разчисти ги всичките!"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভুল উত্তরগুলো তোমার রাজার দিকে এগিয়ে আসছে! একটি কাঁকড়ায় ট্যাপ করে তার দিকে বালি ছোড়ো। সবগুলো সরিয়ে দাও!"
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "ལན་ནོར་བ་ཚོ་ཁྱོད་ཀྱི་རྒྱལ་པོའི་ཕྱོགས་ལ་ཡོང་གི་འདུག སྡིག་སྲིན་ཞིག་མནན་ནས་བྱེ་མ་གཏོར། ཚང་མ་ཕར་སྐྲོད།"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pogrešni odgovori marširaju prema tvom Kralju! Dodirni raka da baciš pijesak na njega. Očisti ih sve!"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les respostes incorrectes avancen cap al teu Rei! Toca un cranc per llançar-li sorra. Fes-los fora a tots!"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Špatné odpovědi pochodují k tvému Králi! Klepni na kraba a hoď po něm písek. Zbav se jich všech!"
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae’r atebion anghywir yn gorymdeithio at dy Frenin! Tapia granc i daflu tywod ato. Cliria nhw i gyd!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forkerte svar marcherer mod din Konge! Tryk på en krabbe for at kaste sand på den. Få dem alle væk!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falsche Antworten marschieren auf deinen König zu! Tippe auf eine Krabbe, um Sand nach ihr zu werfen. Räum sie alle weg!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι λάθος απαντήσεις προχωρούν προς τον Βασιλιά σου! Πάτησε ένα καβούρι για να του πετάξεις άμμο. Διώξ’ τα όλα!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrong answers are marching on your King! Tap a crab to throw sand at it. Clear them all!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Las respuestas incorrectas avanzan hacia tu Rey! Toca un cangrejo para lanzarle arena. ¡Acaba con todos!"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valed vastused marsivad sinu Kuninga poole! Puuduta krabi, et talle liiva visata. Korista nad kõik ära!"
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Erantzun okerrak zure Erregearengana doaz! Ukitu karramarro bat hareaz jotzeko. Kendu guztiak!"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "جواب‌های اشتباه دارند به سمت پادشاهت می‌آیند! روی یک خرچنگ بزن تا به آن شن پرتاب کنی. همه را کنار بزن!"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Väärät vastaukset marssivat kohti Kuningastasi! Napauta rapua heittääksesi sitä hiekalla. Poista ne kaikki!"
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "Skeiv svar marsjera ímóti Konginum hjá tær! Trýst á ein krabba fyri at kasta sand eftir honum. Rudda teir allar burtur!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mauvaises réponses foncent vers ton Roi ! Touche un crabe pour lui lancer du sable. Élimine-les tous !"
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá na freagraí míchearta ag máirseáil i dtreo do Rí! Tapáil portán chun gaineamh a chaitheamh air. Glan amach iad go léir!"
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "As respostas incorrectas avanzan cara ao teu Rei! Toca un cangrexo para botarlle area. Acaba con todos!"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ખોટા જવાબો તમારા રાજા તરફ આવી રહ્યા છે! કરચલાને ટૅપ કરીને તેના પર રેતી ફેંકો. બધાને દૂર કરો!"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התשובות הלא נכונות מתקדמות אל המלך שלך! נוגעים בסרטן כדי לזרוק עליו חול. מסלקים את כולם!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गलत जवाब तुम्हारे राजा की ओर बढ़ रहे हैं! किसी केकड़े पर टैप करके उस पर रेत फेंको। सबको हटा दो!"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pogrešni odgovori marširaju prema tvom Kralju! Dodirni raka da baciš pijesak na njega. Makni ih sve!"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rossz válaszok a Királyod felé menetelnek! Koppints egy rákra, hogy homokot dobj rá. Tüntesd el mindet!"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սխալ պատասխանները գնում են դեպի քո Թագավորը։ Հպիր խեցգետնին՝ նրա վրա ավազ նետելու համար։ Հեռացրու բոլորին։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawaban yang salah sedang berjalan menuju Rajamu! Ketuk kepiting untuk melemparinya dengan pasir. Singkirkan semuanya!"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Röng svör ganga í átt að Konunginum þínum! Pikkaðu á krabba til að kasta sandi í hann. Hreinsaðu þá alla burt!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le risposte sbagliate stanno marciando verso il tuo Re! Tocca un granchio per lanciargli della sabbia. Eliminali tutti!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まちがった答えのカニが王さまに向かってくるよ！ カニをタップして砂を投げよう。全部追い払おう！"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არასწორი პასუხები შენი მეფისკენ მიდიან! შეეხე კიბორჩხალას, რომ ქვიშა ესროლო. მოაშორე ყველა!"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қате жауаптар Патшаңа қарай жүріп келеді! Шаянды түртіп, оған құм лақтыр. Бәрін тазала!"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចម្លើយខុសកំពុងដើរទៅរកស្តេចរបស់អ្នក! ប៉ះក្តាមមួយ ដើម្បីគប់ខ្សាច់ដាក់វា។ កម្ចាត់វាទាំងអស់!"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ತಪ್ಪು ಉತ್ತರಗಳು ನಿನ್ನ ರಾಜನ ಕಡೆ ಬರುತ್ತಿವೆ! ಏಡಿಯನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ ಅದರ ಮೇಲೆ ಮರಳು ಎಸೆ. ಎಲ್ಲವನ್ನೂ ತೆರವು ಮಾಡು!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "틀린 답을 든 게들이 왕에게 다가오고 있어요! 게를 탭해서 모래를 던져요. 모두 막아 주세요!"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຄຳຕອບຜິດກຳລັງໄປຫາກະສັດຂອງເຈົ້າ! ແຕະປູເພື່ອປາຊາຍໃສ່ມັນ. ຈັດການໃຫ້ໝົດ!"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Neteisingi atsakymai žygiuoja tavo Karaliaus link! Paliesk krabą ir mesk į jį smėlio. Pašalink juos visus!"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepareizās atbildes soļo tava Karaļa virzienā! Pieskaries krabim, lai mestu tam smiltis. Aizvāc tos visus!"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Погрешните одговори маршираат кон твојот Крал! Допри рак за да фрлиш песок по него. Тргни ги сите!"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തെറ്റായ ഉത്തരങ്ങൾ നിന്റെ രാജാവിന്റെ അടുത്തേക്ക് വരുന്നു! ഞണ്ടിനെ ടാപ്പ് ചെയ്ത് അതിലേക്ക് മണൽ എറിയൂ. എല്ലാം നീക്കിക്കളയൂ!"
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Буруу хариунууд Хаан руу чинь явж байна! Хавч дээр товшиж, элс шид. Бүгдийг нь зайлуул!"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "चुकीची उत्तरे तुझ्या राजाकडे येत आहेत! खेकड्यावर टॅप करून त्याच्यावर वाळू फेक. सगळ्यांना हटव!"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawapan salah sedang bergerak ke arah Raja kamu! Ketik ketam untuk membaling pasir padanya. Singkirkan semuanya!"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အဖြေမှားတွေက မင်းကြီးဆီ လာနေပြီ! ကဏန်းတစ်ကောင်ကို တို့ပြီး သဲနဲ့ ပစ်လိုက်ပါ။ အားလုံးကို ဖယ်ရှားလိုက်!"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Feil svar marsjerer mot Kongen din! Trykk på en krabbe for å kaste sand på den. Fjern dem alle!"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "गलत उत्तरहरू तिम्रो राजातिर आइरहेका छन्! गँगटोमा ट्याप गरेर त्यसलाई बालुवा हान। सबैलाई हटाऊ!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er komen foute antwoorden op je King af! Tik een krab aan om zand te gooien. Sla ze allemaal weg!"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଭୁଲ ଉତ୍ତରଗୁଡ଼ିକ ତୁମ ରାଜାଙ୍କ ପାଖକୁ ଆସୁଛି! ଗୋଟିଏ କଙ୍କଡ଼ାକୁ ଟ୍ୟାପ୍ କରି ତା’ ଉପରେ ବାଲି ଫିଙ୍ଗ। ସବୁକୁ ହଟାଇ ଦିଅ!"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਗਲਤ ਜਵਾਬ ਤੇਰੇ ਰਾਜੇ ਵੱਲ ਆ ਰਹੇ ਹਨ! ਕੇਕੜੇ ਨੂੰ ਟੈਪ ਕਰਕੇ ਉਸ ਉੱਤੇ ਰੇਤ ਸੁੱਟ। ਸਭ ਨੂੰ ਹਟਾ ਦੇ!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Błędne odpowiedzi maszerują na twojego Króla! Dotknij kraba, aby rzucić w niego piaskiem. Usuń je wszystkie!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As respostas erradas estão a marchar em direção ao teu Rei! Toca num caranguejo para lhe atirar areia. Acaba com todos!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Răspunsurile greșite mărșăluiesc spre Regele tău! Atinge un crab ca să arunci cu nisip în el. Îndepărtează-le pe toate!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неправильные ответы идут к твоему Королю! Нажми на краба, чтобы бросить в него песком. Убери их всех!"
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "වැරදි උත්තර ඔයාගේ රජු ළඟට එනවා! කකුළුවෙකුට ටැප් කරලා ඒකට වැලි විසි කරන්න. ඔක්කොම අයින් කරන්න!"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesprávne odpovede pochodujú k tvojmu Kráľovi! Ťukni na kraba a hoď po ňom piesok. Zbav sa ich všetkých!"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napačni odgovori korakajo proti tvojemu Kralju! Tapni raka, da vanj vržeš pesek. Odstrani jih vse!"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Përgjigjet e gabuara po marshojnë drejt Mbretit tënd! Prek një gaforre për t’i hedhur rërë. Largoji të gjitha!"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Погрешни одговори марширају ка твом Краљу! Додирни рака да бациш песак на њега. Склони их све!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fel svar marscherar mot din Kung! Tryck på en krabba för att kasta sand på den. Få bort dem allihop!"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Majibu yasiyo sahihi yanaelekea kwa Mfalme wako! Gusa kaa ili kumrushia mchanga. Yaondoe yote!"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தவறான பதில்கள் உன் ராஜாவை நோக்கி வருகின்றன! ஒரு நண்டை தட்டி அதன்மேல் மணல் எறி. எல்லாவற்றையும் அகற்று!"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తప్పు సమాధానాలు నీ రాజు వైపు వస్తున్నాయి! పీతపై ట్యాప్ చేసి దానిపై ఇసుక విసురు. అన్నింటినీ తొలగించు!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำตอบผิดกำลังเดินไปหาพระราชาของคุณ! แตะปูเพื่อปาทรายใส่มัน จัดการให้หมดเลย!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanlış cevaplar Kralına doğru ilerliyor! Bir yengece dokunup ona kum at. Hepsini temizle!"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "خاتا جاۋابلار پادىشاھىڭىزغا قاراپ كېلىۋاتىدۇ! قىسقۇچپاقىغا تېگىپ، ئۇنىڭغا قۇم ئېتىڭ. ھەممىسىنى تازىلاڭ!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Неправильні відповіді йдуть до твого Короля! Торкнися краба, щоб кинути в нього піском. Прибери їх усіх!"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "غلط جواب تمہارے بادشاہ کی طرف بڑھ رہے ہیں! کسی کیکڑے کو چھو کر اس پر ریت پھینکو۔ سب کو ہٹا دو!"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Noto‘g‘ri javoblar Qiroling tomon yurmoqda! Qisqichbaqaga tegib, unga qum ot. Hammasini yo‘qot!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các đáp án sai đang tiến về phía Đức Vua của bạn! Chạm vào một con cua để ném cát vào nó. Dọn sạch tất cả nhé!"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "错误答案正朝你的国王走来！点一下螃蟹，向它扔沙子。把它们全赶走！"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Izimpendulo ezingalungile ziya eNkosini yakho! Thinta inkalankala ukuze uyijikijele ngesihlabathi. Zisuse zonke!"
          }
        }
      }
    },
    "tutorial.step.2": {
      "comment": "Walkthrough step 2 of 10: one crab carries the right answer and has to be let through. Spoken to a young child, one or two short sentences.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Een krap dra die regte antwoord. Tref die verkeerde een en laat die regte een jou Koning bereik!"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "አንድ ሸርጣን ትክክለኛውን መልስ ይዟል። የተሳሳተውን ምታና ትክክለኛው ወደ ንጉሥህ እንዲደርስ ተወው!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أحد السرطانات يحمل الإجابة الصحيحة. اضرب صاحب الإجابة الخاطئة ودع صاحب الإجابة الصحيحة يصل إلى ملكك!"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "এটা কেঁকোৰাই শুদ্ধ উত্তৰটো লৈ আহিছে। ভুলটোক আঘাত কৰা আৰু শুদ্ধটোক তোমাৰ ৰজালৈ যাব দিয়া!"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir xərçəng düzgün cavabı aparır. Səhv olanı vur və düzgün olanın Kralına çatmasına icazə ver!"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адзін краб нясе правільны адказ. Трап у няправільнага і прапусці правільнага да свайго Караля!"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Един рак носи верния отговор. Удари грешния и остави верния да стигне до твоя Крал!"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি কাঁকড়া সঠিক উত্তর নিয়ে আসছে। ভুলটিকে আঘাত করো আর সঠিকটিকে তোমার রাজার কাছে পৌঁছাতে দাও!"
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "སྡིག་སྲིན་གཅིག་གིས་ལན་འགྲིག་པ་ཁྱེར་ཡོང་གི་འདུག ལན་ནོར་བ་དེ་རྒྱག་ནས་ལན་འགྲིག་པ་དེ་རྒྱལ་པོའི་རྩར་འགྲོ་རུ་ཆུག"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedan rak nosi tačan odgovor. Pogodi pogrešnog i pusti tačnog da stigne do tvog Kralja!"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cranc porta la resposta correcta. Colpeja l’incorrecte i deixa que el correcte arribi al teu Rei!"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden krab nese správnou odpověď. Tref toho špatného a nech správného dojít ke Králi!"
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae un cranc yn cario’r ateb cywir. Tar y cranc anghywir a gadael i’r un cywir gyrraedd dy Frenin!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Én krabbe har det rigtige svar. Ram den forkerte, og lad den rigtige nå frem til din Konge!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Krabbe trägt die richtige Antwort. Triff die falsche und lass die richtige zu deinem König durch!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα καβούρι κουβαλά τη σωστή απάντηση. Χτύπα το λάθος και άφησε το σωστό να φτάσει στον Βασιλιά σου!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One crab carries the right answer. Smash the wrong one and let the right one reach your King!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cangrejo lleva la respuesta correcta. Golpea al que está mal y deja que el correcto llegue hasta tu Rey."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Üks krabi kannab õiget vastust. Taba valet ja lase õigel oma Kuninga juurde jõuda!"
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Karramarro batek erantzun zuzena darama. Jo okerra eta utzi zuzena zure Erregearengana iristen!"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک خرچنگ جواب درست را دارد. خرچنگِ جواب اشتباه را بزن و بگذار جواب درست به پادشاهت برسد!"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdellä ravulla on oikea vastaus. Osu väärään ja päästä oikea Kuninkaasi luo!"
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein krabbi ber rætta svarið. Rak tann skeiva og lat tann rætta koma fram til Kongin hjá tær!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un crabe porte la bonne réponse. Vise le mauvais et laisse le bon atteindre ton Roi !"
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá portán amháin ag iompar an fhreagra cheart. Buail an ceann mícheart agus lig don cheann ceart do Rí a bhaint amach!"
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cangrexo leva a resposta correcta. Dálle ao incorrecto e deixa que o correcto chegue ao teu Rei!"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એક કરચલો સાચો જવાબ લઈને આવે છે. ખોટા જવાબવાળાને મારો અને સાચા જવાબવાળાને તમારા રાજા સુધી પહોંચવા દો!"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סרטן אחד נושא את התשובה הנכונה. פוגעים בזה עם התשובה הלא נכונה ונותנים לנכון להגיע אל המלך!"
