    "levelIntro.mode.fractions.order": {
      "comment": "Second line of the level intro card for Fractions with \"Single\" selected. Emphasise the key phrase with Markdown **bold**.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Altyd \\*\\*een deel\\*\\* van 'n geheel."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ሁልጊዜ ከአንድ ሙሉ **አንድ ክፍል**።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دائمًا **جزء واحد** من الكل."
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "এটা সম্পূৰ্ণৰ **এটা অংশ**।"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamın həmişə **bir hissəsi**."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Заўсёды **адна частка** цэлага."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Винаги **една част** от цяло."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সব সময় একটি পূর্ণের **একটি অংশ**।"
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "ཆ་ཚང་ཞིག་གི **ཆ་ཤས་གཅིག** ཁོ་ན།"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvijek **jedan dio** cjeline."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre **una sola part** d’un tot."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vždy jen **jedna část** celku."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Bob amser **un rhan** o gyfan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Altid **én del** af en helhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Immer **ein Teil** eines Ganzen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάντα **ένα μέρος** ενός όλου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always a **single part** of a whole."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre **una sola parte** de un todo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Alati **üks osa** tervikust."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Osotasun baten \\*\\*zati bakarra\\*\\* beti."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همیشه **یک بخش** از یک کل."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aina **yksi osa** kokonaisuudesta."
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "Altíð **ein partur** av einum heili."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours **une seule part** d’un tout."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "**Cuid amháin** d’iomlán i gcónaí."
